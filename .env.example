# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for browser use; enforced by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER-SIDE ONLY. Never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit. Only needed for privileged
# server-side operations (e.g. admin scripts, webhooks) that must bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref (from Project Settings > General), used by the Supabase CLI
# to link this repo to your hosted project (`supabase link --project-ref <ref>`).
# SUPABASE_PROJECT_REF=
