# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for browser use; enforced by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER-SIDE ONLY. Never expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit. Required by the AI Website
# Idea Visualizer (/api/visualize, /api/leads) to write visualization
# requests, generated concepts, and leads — tables with no public RLS policy.
# Find it in Dashboard > Project Settings > API > service_role secret.
# SUPABASE_SERVICE_ROLE_KEY=

# Groq API key — SERVER-SIDE ONLY. Powers the AI Website Idea Visualizer
# (structured concept generation + edits via Llama 3.3 70B, plus content
# moderation) through Groq's free, OpenAI-compatible API. Without this,
# /visualizer's generation step returns a clear "not configured" error but
# the rest of the site works normally. Get a free key (no card required) at
# https://console.groq.com/keys.
# GROQ_API_KEY=

# --- Transactional email (optional) ---
# Without these, contact/lead notifications are skipped (logged only) —
# submissions are still saved to the database and visible in /admin.

# Resend API key — SERVER-SIDE ONLY. https://resend.com
# RESEND_API_KEY=

# Verified sender address for outgoing email, e.g. "Vanta Webworks <hello@yourdomain.com>".
# Defaults to Resend's test sender if unset (only deliverable to your own
# Resend account email during testing).
# EMAIL_FROM=

# Where new contact-form and visualizer-lead notifications are sent.
# Server-side only (not prefixed NEXT_PUBLIC_) — this can differ from the
# publicly-displayed NEXT_PUBLIC_CONTACT_EMAIL above.
# CONTACT_EMAIL=

# Supabase project ref (from Project Settings > General), used by the Supabase CLI
# to link this repo to your hosted project (`supabase link --project-ref <ref>`).
# SUPABASE_PROJECT_REF=

# --- Site configuration ---

# Full production URL, used for metadata, Open Graph tags, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Real contact details (leave unset to hide the corresponding UI) ---
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# NEXT_PUBLIC_BUSINESS_ADDRESS=
# NEXT_PUBLIC_SERVICE_AREA=

# --- Real social profile URLs (leave unset to hide the corresponding icon) ---
# NEXT_PUBLIC_SOCIAL_TWITTER=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_GITHUB=
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
